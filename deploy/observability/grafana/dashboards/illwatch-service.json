{
  "uid": "illwatch-service",
  "title": "ILL Watch — Service",
  "tags": [
    "illwatch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "API joignable",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "up{job=\"illwatch-api\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "PostgreSQL",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "illwatch_database_up",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redis",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "illwatch_redis_up",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Démarrage de l'API",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "illwatch_process_start_time_seconds * 1000",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requêtes par seconde (statut)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "sum by (status) (rate(illwatch_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Taux de réponses 5xx",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "sum(rate(illwatch_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(illwatch_http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latence de l'API (p50, p95, p99)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(illwatch_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(illwatch_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(illwatch_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Routes les plus lentes (p95, 1 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (route, le) (rate(illwatch_http_request_duration_seconds_bucket[1h]))))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Refus d'authentification et d'autorisation (24 h)",
      "description": "Échecs et refus consignés au journal d'audit, par action.",
      "datasource": {
        "type": "prometheus",
        "uid": "illwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "illwatch-prometheus"
          },
          "expr": "illwatch_audit_refusals_24h",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    }
  ]
}
