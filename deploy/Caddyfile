# ============================================================================
# SENTRY — reverse proxy TLS (M7 lot 3, ADR-013)
#
# SENTRY_DOMAIN=sentry.exemple.eu : certificat Let's Encrypt automatique (ports 80 et 443
#                                   joignables depuis Internet, DNS pointant sur l'hôte).
# SENTRY_DOMAIN=localhost (défaut) : certificat de l'autorité interne de Caddy, pour tester.
#
# Caddy fixe X-Forwarded-For à l'adresse réelle du client et ignore celui qu'il reçoit
# (aucun proxy de confiance déclaré) : un client ne peut pas usurper une adresse auprès de
# la limitation de débit ou du journal d'audit. Côté API, uvicorn n'accepte cet en-tête
# que de l'adresse de Caddy (--forwarded-allow-ips).
# ============================================================================
{
	# Ajouter « email vous@exemple.eu » pour être prévenu de l'expiration des certificats.
	admin off
}

{$SENTRY_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy {$SENTRY_UPSTREAM:api:8000} {
		header_down -Server
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	request_body {
		max_size 10MB
	}
	log {
		output stdout
		format json
	}
}
