# Site de présentation servi par Caddy à côté de l'application (ADR-027, lot S6).
# Exemple : à fusionner dans deploy/Caddyfile une fois le domaine choisi.
#   illwatch.example      → site de présentation (Website/dist)
#   app.illwatch.example  → application (inchangé, ADR-013)

illwatch.example {
	root * /srv/illwatch-website
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"

	# Lot S6 : pays du visiteur → langue, par l'application (DB-IP Lite locale, ADR-019).
	# La réponse ne contient que {"lang": "xx"} ; l'adresse n'est ni journalisée ni conservée.
	# Construire alors le site avec ILLWATCH_SITE_GEO_ENDPOINT=/geo-lang.
	# handle /geo-lang {
	# 	rewrite * /api/v1/site/lang
	# 	reverse_proxy illwatch-api:8000
	# }

	file_server
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
