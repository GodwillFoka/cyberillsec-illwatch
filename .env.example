# ============================================================================
# SENTRY — Modèle de configuration locale
# Copier en `.env` puis adapter :  cp .env.example .env
# Ne JAMAIS committer le fichier `.env` (il est ignoré par git).
# ============================================================================

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Base de données --------------------------------------------------------
# Port hôte 5433 (docker-compose.yml) : évite le conflit avec un PostgreSQL installé en natif.
DATABASE_URL=postgresql+asyncpg://sentry:sentry@localhost:5433/sentry
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# --- Cache / broker ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Sécurité ---------------------------------------------------------------
# En production, SENTRY refuse de démarrer si la clé est celle par défaut ou fait
# moins de 32 caractères, ou si DEBUG=true. Générer : openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Connecteurs CTI externes (optionnels mais fortement recommandés) -------
# https://nvd.nist.gov/developers/request-an-api-key (gratuit) — 10x plus rapide pour la synchro CVE
NVD_API_KEY=
# https://otx.alienvault.com/api (gratuit) — envoyée en en-tête, uniquement à otx.alienvault.com
OTX_API_KEY=
# Pages de 50 pulses lues au plus par collecte OTX (augmenter pour une première collecte)
OTX_MAX_PAGES=20
# Identifiants TAXII 2.1 par hôte, séparés par « ; » :
#   hote=utilisateur:motdepasse   (Basic)      hote=bearer:JETON   (Authorization: Bearer)
#   hote=header:x-api-key:CLE     (en-tête dédié, ex. CrowdSec)
# RedEye (jeton gratuit) : feeds.redeyesecurity.com=bearer:rdi_…
TAXII_AUTH=osint.digitalside.it=guest:guest
TAXII_MAX_PAGES=20
# library = taxii2-client (défaut) ; builtin = transport HTTP maison (repli)
TAXII_CLIENT=library
# https://auth.abuse.ch/ (gratuit) — exigé par URLhaus pour les téléchargements
ABUSECH_AUTH_KEY=

# --- Collecte ---------------------------------------------------------------
DEFAULT_POLLING_INTERVAL=3600
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
FEED_MAX_BYTES=20971520
# Verrou Redis par flux (s) : doit dépasser la plus longue collecte
COLLECT_LOCK_TTL_SECONDS=900
# Période de réveil de `sentry feeds worker` (s)
WORKER_TICK_SECONDS=60

# --- Moteur CVE (phase 3) ---------------------------------------------------
# Profondeur de la 1re synchronisation NVD (les CVE du catalogue KEV sont toujours importées)
NVD_INITIAL_DAYS=30
NVD_RESULTS_PER_PAGE=500
# Synchronisation KEV + NVD + EPSS par `sentry feeds worker` (s)
CVE_SYNC_INTERVAL_SECONDS=21600

# --- Scoring & alerting -----------------------------------------------------
RISK_ALERT_THRESHOLD=75
# Webhook appelé à chaque alerte (Slack, Mattermost…). Laisser vide pour désactiver.
ALERT_WEBHOOK_URL=
