# ============================================================================
# ILLWATCH — Modèle de configuration locale
# Copier en `.env` puis adapter :  cp .env.example .env
# Ne JAMAIS committer le fichier `.env` (il est ignoré par git).
# Une variable laissée vide (ex. DOCS_ENABLED=) prend sa valeur par défaut.
# Autre emplacement : ILLWATCH_ENV_FILE=/chemin/env (variable d'environnement, vide = aucun fichier).
# ============================================================================

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Base de données --------------------------------------------------------
# Port hôte 5433 (docker-compose.yml) : évite le conflit avec un PostgreSQL installé en natif.
# M7 lot 2 — deux rôles : l'application (illwatch_app, aucun droit de structure) et les
# migrations (illwatch, propriétaire). Créer le rôle applicatif une fois sur un volume existant :
#   ILLWATCH_APP_DB_PASSWORD=illwatch-app-dev illwatch db app-role illwatch_app --create
# Caractères spéciaux d'un mot de passe dans une URL : à encoder (« : » → %3A, « @ » → %40).
DATABASE_URL=postgresql+asyncpg://illwatch_app:illwatch-app-dev@localhost:5433/illwatch
MIGRATION_DATABASE_URL=postgresql+asyncpg://illwatch:illwatch@localhost:5433/illwatch
DATABASE_APP_ROLE=illwatch_app
POSTGRES_APP_PASSWORD=illwatch-app-dev
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# --- Cache / broker ---------------------------------------------------------
# Mot de passe Redis (M7 lot 2) : le même dans REDIS_PASSWORD (serveur Compose) et REDIS_URL.
# En production, ILLWATCH refuse de démarrer sans mot de passe ou avec la valeur de développement.
REDIS_PASSWORD=illwatch-dev-redis
REDIS_URL=redis://:illwatch-dev-redis@localhost:6379/0

# --- Sécurité ---------------------------------------------------------------
# En production, ILLWATCH refuse de démarrer si la clé est celle par défaut ou fait
# moins de 32 caractères, ou si DEBUG=true. Générer : openssl rand -hex 32
SECRET_KEY=change-me-in-production
# Rotation : déplacer l'ancienne clé ici, en générer une nouvelle dans SECRET_KEY ; retirer
# SECRET_KEY_PREVIOUS une fois ACCESS_TOKEN_EXPIRE_MINUTES écoulées.
SECRET_KEY_PREVIOUS=
# Jeton d'accès court, jeton de rafraîchissement révocable (POST /api/v1/auth/refresh).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Origines autorisées à appeler l'API depuis un navigateur (liste JSON) ; « * » refusé en production.
# CORS_ORIGINS=["https://illwatch.example.org"]
REFRESH_TOKEN_EXPIRE_DAYS=7
# Force brute sur 15 min → HTTP 429 : 5 échecs d'une adresse sur un compte, 50 sur un compte
# toutes adresses confondues, 20 d'une adresse tous comptes confondus.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# Documentation /docs : vide = exposée hors production, masquée en production.
DOCS_ENABLED=
# En-tête HSTS : vide = actif en production uniquement (API servie derrière TLS).
HSTS_ENABLED=
# Derrière un reverse proxy : adresses dont uvicorn accepte X-Forwarded-For (sinon la
# limitation par IP verrait l'adresse du proxy pour tous les clients). Défaut : 127.0.0.1.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# --- Connecteurs CTI externes (optionnels mais fortement recommandés) -------
# https://nvd.nist.gov/developers/request-an-api-key (gratuit) — 10x plus rapide pour la synchro CVE
NVD_API_KEY=
# https://otx.alienvault.com/api (gratuit) — envoyée en en-tête, uniquement à otx.alienvault.com
OTX_API_KEY=
# Pages de 50 pulses lues au plus par collecte OTX (augmenter pour une première collecte)
OTX_MAX_PAGES=20
# Identifiants TAXII 2.1 par hôte, séparés par « ; » :
#   hote=utilisateur:motdepasse   (Basic)      hote=bearer:JETON   (Authorization: Bearer)
#   hote=header:x-api-key:CLE     (en-tête dédié, ex. CrowdSec)
# RedEye (jeton gratuit) : feeds.redeyesecurity.com=bearer:rdi_…
TAXII_AUTH=osint.digitalside.it=guest:guest
TAXII_MAX_PAGES=20
# library = taxii2-client (défaut) ; builtin = transport HTTP maison (repli)
TAXII_CLIENT=library
# https://auth.abuse.ch/ (gratuit) — exigé par URLhaus pour les téléchargements
ABUSECH_AUTH_KEY=

# --- Collecte ---------------------------------------------------------------
DEFAULT_POLLING_INTERVAL=3600
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
FEED_MAX_BYTES=20971520
# Verrou Redis par flux (s) : doit dépasser la plus longue collecte
COLLECT_LOCK_TTL_SECONDS=900
# Période de réveil de `illwatch feeds worker` (s)
WORKER_TICK_SECONDS=60

# --- Moteur CVE (phase 3) ---------------------------------------------------
# Profondeur de la 1re synchronisation NVD (les CVE du catalogue KEV sont toujours importées)
NVD_INITIAL_DAYS=30
NVD_RESULTS_PER_PAGE=500
# Synchronisation KEV + NVD + EPSS par `illwatch feeds worker` (s)
CVE_SYNC_INTERVAL_SECONDS=21600

# --- Threat hunting (phase 6) -------------------------------------------------
# Chasse planifiée sur la base d'IOC par `illwatch feeds worker` (s) ; 0 = désactivée
HUNT_INTERVAL_SECONDS=86400
TOR_EXIT_LIST_URL=https://check.torproject.org/torbulkexitlist

# --- Scoring & alerting -----------------------------------------------------
RISK_ALERT_THRESHOLD=75
# Webhook appelé à chaque alerte (Slack, Mattermost…). Laisser vide pour désactiver.
ALERT_WEBHOOK_URL=
