{
  "name": "illwatch-web",
  "private": true,
  "version": "0.1.0",
  "description": "Interface web d'ILLWATCH (ADR-016) : React, TypeScript, TanStack Query, temps réel SSE.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "echarts": "6.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
